# ============================================================
# DOCURAPI CORE
# ============================================================

DOCURAPI_SECRET_KEY=replace-with-a-long-random-production-secret
DOCURAPI_SESSION_SECRET=replace-with-a-different-long-random-secret
DOCURAPI_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-webhook-secret

DOCURAPI_DEV_MODE=0
DOCURAPI_COOKIE_SECURE=1

DOCURAPI_PUBLIC_BASE_URL=https://example.com
DOCURAPI_INTERNAL_BASE_URL=http://127.0.0.1:8000


# ============================================================
# DATABASE
# ============================================================

DOCURAPI_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=


# ============================================================
# BILLING
# ============================================================

DOCURAPI_PAYMENT_MODE=disabled
DOCURAPI_BILLING_ENFORCEMENT=0
DOCURAPI_BILLING_ADMIN_BYPASS=0
DOCURAPI_BILLING_TAX_PERCENT=0
DOCURAPI_BILLING_RESERVATION_TTL=1800


# ============================================================
# MIDTRANS
# ============================================================

DOCURAPI_MIDTRANS_ENV=sandbox
DOCURAPI_MIDTRANS_SERVER_KEY=
DOCURAPI_MIDTRANS_CLIENT_KEY=
DOCURAPI_MIDTRANS_VERIFY_STATUS=1


# ============================================================
# EMAIL
# ============================================================

DOCURAPI_EMAIL_MODE=disabled
DOCURAPI_EMAIL_FROM=
DOCURAPI_EMAIL_FROM_NAME=DocuRapi

DOCURAPI_SMTP_HOST=
DOCURAPI_SMTP_PORT=587
DOCURAPI_SMTP_USERNAME=
DOCURAPI_SMTP_PASSWORD=
DOCURAPI_SMTP_SSL=0
DOCURAPI_SMTP_STARTTLS=1


# ============================================================
# BACKGROUND PROCESSING
# ============================================================

DOCURAPI_BACKGROUND_WORKERS=2
DOCURAPI_BACKGROUND_TIMEOUT=900


# ============================================================
# BACKUP
# ============================================================

DOCURAPI_AUTO_BACKUP=0
DOCURAPI_AUTO_BACKUP_INTERVAL=86400
DOCURAPI_AUTO_BACKUP_KEEP=7

# ============================================================
# DOCURAPI OBJECT STORAGE
# ============================================================

# local atau s3
DOCURAPI_OBJECT_STORAGE_BACKEND=local

# Digunakan pada backend local
DOCURAPI_OBJECT_STORAGE_LOCAL_ROOT=storage/object_store

# Digunakan pada backend s3
DOCURAPI_OBJECT_STORAGE_BUCKET=
DOCURAPI_OBJECT_STORAGE_REGION=
DOCURAPI_OBJECT_STORAGE_ENDPOINT=
DOCURAPI_OBJECT_STORAGE_ACCESS_KEY=
DOCURAPI_OBJECT_STORAGE_SECRET_KEY=
DOCURAPI_OBJECT_STORAGE_SESSION_TOKEN=

# Masa berlaku link download, dalam detik
DOCURAPI_OBJECT_STORAGE_PRESIGNED_TTL=900

# ============================================================
# DOCURAPI HYBRID STORAGE RUNTIME
# ============================================================

# false: database tetap menyimpan path lokal sebagai referensi aktif.
# Object storage dapat tetap menerima salinan mirror.
#
# true: database boleh menyimpan object://... sebagai referensi aktif.
DOCURAPI_OBJECT_STORAGE_RUNTIME_ENABLED=false

# Pertahankan file lokal selama masa transisi.
DOCURAPI_OBJECT_STORAGE_KEEP_LOCAL_COPY=true

# Cache sementara untuk download/materialisasi object.
DOCURAPI_OBJECT_STORAGE_CACHE_ROOT=/tmp/docurapi-object-cache
